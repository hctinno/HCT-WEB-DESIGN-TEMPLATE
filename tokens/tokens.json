{
  "$meta": {
    "name": "HCT Design Tokens",
    "version": "0.1.0",
    "description": "대시보드·분석도구·관리도구용 디자인 토큰. 이 파일이 유일한 원천(Source of Truth)입니다.",
    "density": "compact",
    "reference": ["Jira", "Notion", "Slack", "Linear"],
    "howToRebrand": "brand.accent 스케일과 font.family 값만 교체하면 전체 시스템 색이 바뀝니다. semantic 레이어는 건드리지 마세요."
  },

  "brand": {
    "$comment": "HCT 브랜드 색상 확정 시 이 블록만 교체합니다. 50~900 스케일을 모두 채워야 라이트/다크가 함께 동작합니다.",
    "accent": {
      "50":  "#EEF4FF",
      "100": "#DBE6FF",
      "200": "#BFD2FF",
      "300": "#93B4FF",
      "400": "#6090FF",
      "500": "#3B76F6",
      "600": "#2563EB",
      "700": "#1D4FD8",
      "800": "#1E40AF",
      "900": "#1E3A8A"
    }
  },

  "palette": {
    "$comment": "원시 색상. 컴포넌트에서 직접 쓰지 마세요. semantic을 통해서만 사용합니다.",
    "neutral": {
      "0":   "#FFFFFF",
      "25":  "#FBFBFC",
      "50":  "#F7F8F9",
      "100": "#F1F2F4",
      "200": "#EBECF0",
      "300": "#DCDFE4",
      "400": "#B3B9C4",
      "500": "#8590A2",
      "600": "#6B778C",
      "700": "#44546F",
      "800": "#2C3E5D",
      "900": "#172B4D",
      "950": "#0D1526"
    },
    "dark": {
      "0":   "#0D0F12",
      "25":  "#101317",
      "50":  "#16191E",
      "100": "#1A1E24",
      "200": "#1E2228",
      "300": "#23272E",
      "400": "#2E333B",
      "500": "#464C56",
      "600": "#646B77",
      "700": "#8A919D",
      "800": "#A9B0BA",
      "900": "#E6E8EB",
      "950": "#F5F6F8"
    },
    "green":  { "100": "#E7F7EE", "200": "#A7E3C0", "500": "#16A34A", "600": "#15803D", "700": "#166534", "900": "#0F2E1E", "300": "#4ADE80" },
    "amber":  { "100": "#FEF5E0", "200": "#F5D48A", "500": "#D97706", "600": "#B45309", "700": "#92400E", "900": "#33230A", "300": "#FBBF24" },
    "red":    { "100": "#FDECEC", "200": "#F5B5B5", "500": "#DC2626", "600": "#B91C1C", "700": "#991B1B", "900": "#3A1516", "300": "#F87171" },
    "blue":   { "100": "#EAF2FF", "200": "#B8D2FF", "500": "#2563EB", "600": "#1D4FD8", "700": "#1E40AF", "900": "#12233F", "300": "#7CA9FF" },
    "purple": { "100": "#F2EEFE", "200": "#CFC0F7", "500": "#7C3AED", "600": "#6D28D9", "700": "#5B21B6", "900": "#241640", "300": "#B292FA" }
  },

  "semantic": {
    "$comment": "컴포넌트가 실제로 사용하는 유일한 색상 레이어. 모든 값은 light/dark 쌍을 가집니다.",
    "bg": {
      "canvas":  { "light": "{palette.neutral.50}",  "dark": "{palette.dark.0}",   "usage": "페이지 최하단 배경" },
      "surface": { "light": "{palette.neutral.0}",   "dark": "{palette.dark.50}",  "usage": "카드·패널·테이블 본문" },
      "raised":  { "light": "{palette.neutral.0}",   "dark": "{palette.dark.200}", "usage": "드롭다운·모달·팝오버 (떠 있는 것)" },
      "sunken":  { "light": "{palette.neutral.100}", "dark": "{palette.dark.25}",  "usage": "테이블 헤더·입력 내부·인셋 영역" },
      "hover":   { "light": "{palette.neutral.100}", "dark": "{palette.dark.200}", "usage": "행·항목 호버" },
      "active":  { "light": "{palette.neutral.200}", "dark": "{palette.dark.300}", "usage": "눌린 상태·선택된 행" },
      "sidebar": { "light": "{palette.neutral.50}",  "dark": "{palette.dark.25}",  "usage": "사이드바 배경" }
    },
    "text": {
      "primary":   { "light": "{palette.neutral.900}", "dark": "{palette.dark.900}", "usage": "본문·제목" },
      "secondary": { "light": "{palette.neutral.700}", "dark": "{palette.dark.800}", "usage": "보조 설명·레이블" },
      "tertiary":  { "light": "{palette.neutral.600}", "dark": "{palette.dark.700}", "usage": "메타 정보·플레이스홀더" },
      "disabled":  { "light": "{palette.neutral.400}", "dark": "{palette.dark.500}", "usage": "비활성" },
      "inverse":   { "light": "{palette.neutral.0}",   "dark": "{palette.dark.0}",   "usage": "진한 배경 위 텍스트" },
      "link":      { "light": "{brand.accent.600}",    "dark": "{brand.accent.400}", "usage": "링크" }
    },
    "border": {
      "subtle":  { "light": "{palette.neutral.200}", "dark": "{palette.dark.300}", "usage": "테이블 행 구분선 등 약한 선" },
      "default": { "light": "{palette.neutral.300}", "dark": "{palette.dark.400}", "usage": "카드·입력 기본 테두리" },
      "strong":  { "light": "{palette.neutral.400}", "dark": "{palette.dark.500}", "usage": "강조 구획" },
      "focus":   { "light": "{brand.accent.600}",    "dark": "{brand.accent.400}", "usage": "포커스 링" }
    },
    "accent": {
      "solid":      { "light": "{brand.accent.600}", "dark": "{brand.accent.500}", "usage": "주 버튼 배경" },
      "solidHover": { "light": "{brand.accent.700}", "dark": "{brand.accent.400}", "usage": "주 버튼 호버" },
      "subtle":     { "light": "{brand.accent.50}",  "dark": "#152238",            "usage": "선택된 내비 항목 배경" },
      "text":       { "light": "{brand.accent.700}", "dark": "{brand.accent.300}", "usage": "강조 텍스트" },
      "border":     { "light": "{brand.accent.200}", "dark": "{brand.accent.800}", "usage": "강조 테두리" }
    },
    "status": {
      "$comment": "관리도구의 핵심. 상태는 반드시 색상으로 구분되며, 색상만으로 구분하지 않고 항상 텍스트를 동반합니다(접근성).",
      "success": { "bg": {"light":"{palette.green.100}","dark":"{palette.green.900}"},  "border": {"light":"{palette.green.200}","dark":"{palette.green.700}"},  "text": {"light":"{palette.green.600}","dark":"{palette.green.300}"},  "solid": {"light":"{palette.green.500}","dark":"{palette.green.500}"} },
      "warning": { "bg": {"light":"{palette.amber.100}","dark":"{palette.amber.900}"},  "border": {"light":"{palette.amber.200}","dark":"{palette.amber.700}"},  "text": {"light":"{palette.amber.600}","dark":"{palette.amber.300}"},  "solid": {"light":"{palette.amber.500}","dark":"{palette.amber.500}"} },
      "danger":  { "bg": {"light":"{palette.red.100}","dark":"{palette.red.900}"},      "border": {"light":"{palette.red.200}","dark":"{palette.red.700}"},      "text": {"light":"{palette.red.600}","dark":"{palette.red.300}"},      "solid": {"light":"{palette.red.500}","dark":"{palette.red.500}"} },
      "info":    { "bg": {"light":"{palette.blue.100}","dark":"{palette.blue.900}"},    "border": {"light":"{palette.blue.200}","dark":"{palette.blue.700}"},    "text": {"light":"{palette.blue.600}","dark":"{palette.blue.300}"},    "solid": {"light":"{palette.blue.500}","dark":"{palette.blue.500}"} },
      "neutral": { "bg": {"light":"{palette.neutral.100}","dark":"{palette.dark.200}"}, "border": {"light":"{palette.neutral.300}","dark":"{palette.dark.400}"}, "text": {"light":"{palette.neutral.700}","dark":"{palette.dark.800}"}, "solid": {"light":"{palette.neutral.500}","dark":"{palette.dark.600}"} },
      "review":  { "bg": {"light":"{palette.purple.100}","dark":"{palette.purple.900}"},"border": {"light":"{palette.purple.200}","dark":"{palette.purple.700}"},"text": {"light":"{palette.purple.600}","dark":"{palette.purple.300}"},"solid": {"light":"{palette.purple.500}","dark":"{palette.purple.500}"} }
    },
    "workflow": {
      "$comment": "지라식 업무 상태 → status 매핑. 개발 에이전트는 임의의 색을 고르지 말고 이 표를 따릅니다.",
      "todo": "neutral",
      "inProgress": "info",
      "inReview": "review",
      "blocked": "danger",
      "done": "success",
      "warning": "warning"
    }
  },

  "font": {
    "family": {
      "sans": "Pretendard Variable, Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, 'Helvetica Neue', 'Segoe UI', 'Apple SD Gothic Neo', 'Noto Sans KR', 'Malgun Gothic', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "size": {
      "$comment": "본문 14px 기준의 고밀도 스케일. 관리도구는 16px 본문을 쓰지 않습니다.",
      "micro":   { "size": "11px", "lineHeight": "14px", "usage": "테이블 메타·타임스탬프" },
      "xs":      { "size": "12px", "lineHeight": "16px", "usage": "뱃지·캡션·보조 레이블" },
      "sm":      { "size": "13px", "lineHeight": "18px", "usage": "밀집 테이블 셀·사이드바" },
      "base":    { "size": "14px", "lineHeight": "20px", "usage": "기본 본문·버튼·입력" },
      "md":      { "size": "16px", "lineHeight": "24px", "usage": "섹션 제목(h3)" },
      "lg":      { "size": "20px", "lineHeight": "28px", "usage": "페이지 제목(h2)" },
      "xl":      { "size": "24px", "lineHeight": "32px", "usage": "화면 제목(h1)" },
      "metric":  { "size": "28px", "lineHeight": "34px", "usage": "KPI 수치" },
      "metricLg":{ "size": "34px", "lineHeight": "40px", "usage": "대형 KPI 수치" }
    },
    "weight": { "normal": "400", "medium": "500", "semibold": "600", "bold": "700" },
    "tracking": { "tight": "-0.01em", "normal": "0", "wide": "0.02em", "caps": "0.06em" }
  },

  "space": {
    "$comment": "4px 기준. 고밀도이므로 24px를 넘는 간격은 섹션 분리에만 사용합니다.",
    "0": "0px", "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px", "2.5": "10px",
    "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },

  "radius": {
    "$comment": "지라형은 둥글기가 작습니다. 12px 이상은 쓰지 않습니다.",
    "none": "0px", "sm": "3px", "md": "6px", "lg": "8px", "xl": "12px", "full": "9999px"
  },

  "layout": {
    "$comment": "앱 셸 고정 규격. 개발 에이전트는 이 값을 바꾸지 않습니다.",
    "sidebarWidth": "240px",
    "sidebarCollapsedWidth": "56px",
    "topbarHeight": "48px",
    "rightPanelWidth": "360px",
    "rightPanelWideWidth": "480px",
    "contentMaxWidth": "1440px",
    "pagePaddingX": "24px",
    "pagePaddingY": "20px"
  },

  "control": {
    "$comment": "버튼·입력·행의 높이. 밀도 통일의 핵심이라 임의 값 금지.",
    "height": { "xs": "24px", "sm": "28px", "md": "32px", "lg": "36px" },
    "rowHeight": { "compact": "32px", "default": "40px", "relaxed": "48px" },
    "iconSize": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px" }
  },

  "elevation": {
    "$comment": "다크 모드에서 그림자는 거의 보이지 않으므로 테두리로 고도를 표현합니다.",
    "none": { "light": "none", "dark": "none" },
    "sm":   { "light": "0 1px 2px 0 rgb(9 30 66 / 0.08)", "dark": "0 1px 2px 0 rgb(0 0 0 / 0.4)" },
    "md":   { "light": "0 2px 8px -1px rgb(9 30 66 / 0.12), 0 0 1px rgb(9 30 66 / 0.10)", "dark": "0 2px 8px -1px rgb(0 0 0 / 0.5)" },
    "lg":   { "light": "0 8px 24px -4px rgb(9 30 66 / 0.16), 0 0 1px rgb(9 30 66 / 0.10)", "dark": "0 8px 24px -4px rgb(0 0 0 / 0.6)" },
    "overlay": { "light": "0 16px 48px -8px rgb(9 30 66 / 0.24)", "dark": "0 16px 48px -8px rgb(0 0 0 / 0.7)" }
  },

  "motion": {
    "$comment": "관리도구는 빠릿해야 합니다. 300ms를 넘기지 마세요.",
    "duration": { "instant": "80ms", "fast": "120ms", "normal": "180ms", "slow": "260ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },

  "zIndex": {
    "base": 0, "sticky": 10, "sidebar": 20, "topbar": 30, "drawer": 40,
    "overlay": 50, "modal": 60, "popover": 70, "toast": 80, "commandPalette": 90
  },

  "breakpoint": {
    "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px",
    "$comment": "lg(1024px) 미만에서 사이드바는 오버레이로, 우측 패널은 전체 화면으로 전환됩니다."
  }
}
